extends SceneTree
const Store = preload("res://scripts/save_store.gd")
const Route = preload("res://scripts/jade_route.gd")
const Model = preload("res://scripts/tactical_encounter.gd")
const Migration = preload("res://scripts/preview32_migration.gd")
const Rules = preload("res://scripts/progression_rules.gd")
const Flow = preload("res://scripts/aftermath_flow.gd")
const Transition = preload("res://scripts/combat_transition.gd")
const Stage = preload("res://scripts/trial_stage.gd")
const PATH := "user://unification-tests.json"
var checks := 0
var failures := 0
var app: Node
func _initialize(): call_deferred("run")
func check(value: bool, label: String):
	checks += 1
	if not value:
		failures += 1
		push_error("FAIL: " + label)
func clean():
	for suffix in ["", ".bak", ".tmp", ".pre-unification"]:
		if FileAccess.file_exists(PATH+suffix): DirAccess.remove_absolute(PATH+suffix)
func canonical(value: Variant) -> Variant: return JSON.parse_string(JSON.stringify(value,"",true,true))
func button(node: Node, prefix: String) -> Button:
	if node is Button and node.text.begins_with(prefix): return node
	for child in node.get_children():
		var found := button(child,prefix)
		if found != null: return found
	return null
func finish_hit():
	var model := Model.new()
	check(model.restore(app.profile.campaign.encounter),"restore finishing hit")
	model.state.enemy.hp = 1
	model._sync()
	app.profile.campaign.encounter = model.snapshot()
	check(app.trial_action("karmany","golpe"),"commit finishing hit")
	app.response_timer.stop()
func run():
	app = root.get_node("App")
	app.response_timer.stop()
	app.load_failed = false
	app.storage = Store.new(PATH)
	# Fixtures generated by the recovered Preview32 engine, not by the new adapter.
	var dir := DirAccess.open("res://tests/fixtures/preview32")
	var files := dir.get_files()
	check(files.size()==69,"69 original Preview32 phase snapshots")
	for file in files:
		clean()
		var raw := FileAccess.get_file_as_string("res://tests/fixtures/preview32/"+file)
		var old: Dictionary = JSON.parse_string(raw)
		var handle := FileAccess.open(PATH,FileAccess.WRITE)
		handle.store_string(raw)
		handle.close()
		var loaded: Dictionary = app.storage.load_profile()
		check(app.storage.last_error.is_empty() and Store.valid(loaded),"load original "+file)
		check(FileAccess.get_file_as_string(PATH)==raw,"read leaves original bytes intact")
		check(canonical(loaded.skill_tree)==canonical(old.skill_tree),"trainer, purchases and captures preserved")
		check(canonical(loaded.campaign.collection)==canonical(old.campaign.collection),"all collection instance IDs preserved")
		for key in ["team","route","exploration"]:
			check(canonical(loaded.campaign[key])==canonical(old.campaign[key]),"preserve "+key+" "+file)
		check(canonical(loaded.campaign.progression.units)==canonical(old.campaign.progression.units),"unit levels and partial XP preserved")
		check(loaded.campaign.progression.trainer_xp==old.campaign.progression.trainer_xp,"trainer partial XP preserved")
		check(canonical(loaded.campaign.progression.last_reward)==canonical(old.campaign.progression.last_reward),"reward receipt preserved")
		var e: Dictionary = loaded.campaign.encounter
		if not e.is_empty():
			for key in ["id","revision","phase","round","player_hp","enemy_hp","rolls","capture","members","enemy_team"]:
				check(canonical(e[key])==canonical(old.campaign.encounter[key]),"frozen encounter preserves "+key)
		check(app.storage.save_profile(loaded),"save migrated original "+file)
		check(app.storage.load_profile()==loaded,"migrated exact roundtrip "+file)
		if Migration.needed(old): check(FileAccess.get_file_as_string(PATH+".pre-unification")==raw,"immutable legacy backup")
		check(Migration.convert(loaded)==loaded,"migration idempotent")
		app.profile = loaded
		if e.get("phase")=="capture":
			var before: Dictionary = loaded.campaign.progression.duplicate(true)
			if e.capture_choice.is_empty(): check(app.trial_action("choose_capture","rival-0"),"continue original final choice")
			if app.profile.campaign.encounter.capture.actions.size()<3: check(app.trial_action("capture"),"continue original capture attempts")
			check(app.profile.campaign.progression.last_reward==before.last_reward,"resuming capture cannot award XP again")
		elif e.get("phase")=="battle":
			check(app.trial_action("enemy") if e.enemy_pending else app.trial_action("karmany","golpe"),"continue original live battle")
			app.response_timer.stop()
	# Real production routes, all twelve points, distinct caps and final reserves.
	clean()
	app.profile = Store.defaults()
	app.profile.settings.sound = false
	app.profile.skill_tree.level = 15
	app.profile.skill_tree.unlocks = ["veil"]
	app.profile.campaign.progression.units["zephyr-start"]={"level":15,"xp":0}
	for region in ["jade","veil"]:
		check(Route.points(region).size()==6,"six recovered points in "+region)
		check(app.select_region(region),"travel to "+region)
		for point in Route.points(region):
			app.profile.campaign.exploration.value=100
			check(app.start_route(point.id),"enter "+point.id)
			check(app.profile.campaign.exploration.value==100-point.cost,"exact recovered stamina cost")
			var before: Dictionary = app.profile.duplicate(true)
			check(app.start_route(point.id) and before==app.profile,"resume costs nothing")
			check(app.discover_location(app.profile.campaign.encounter.id),"reveal encounter")
			app.profile.campaign.encounter.rolls=[0.875,0.125,0.5]
			var e: Dictionary = app.profile.campaign.encounter
			check(e.enemy.level==point.level and e.regional.reward==point.first_xp and e.regional.cap==Rules.region(region).xp_cap,"recovered level, XP and cap")
			check(e.enemy_team.size()==point.enemies.size(),"correct consecutive enemy count")
			var wins: int = app.profile.campaign.victories
			finish_hit()
			if point.enemies.size()==2:
				check(app.profile.campaign.encounter.phase=="battle" and app.profile.campaign.victories==wins,"first final rival grants no victory")
				check(not app.profile.campaign.encounter.enemy_pending and not app.trial_action("enemy"),"reserve has no free attack")
				finish_hit()
			check(app.profile.campaign.victories==wins+1 and Route.completed(app.profile.campaign.route,point.id),"one complete victory receipt")
			check(app.storage.load_profile()==app.profile,"win persists "+point.id)
			var receipt: Dictionary = app.profile.campaign.progression.last_reward.duplicate(true)
			check(not app.trial_action("karmany","golpe") and receipt==app.profile.campaign.progression.last_reward,"no repeated award")
			if app.profile.campaign.encounter.capture_choice.is_empty(): check(app.trial_action("choose_capture","rival-0"),"one final binding target")
			app.profile.campaign.encounter.rolls=[0.125,0.5,0.875]
			check(app.trial_action("capture"),"capture actual species")
			var id: String = app.profile.campaign.encounter.id
			check(app.profile.campaign.progression.units[id].level==point.level,"capture keeps encountered level")
			check(app.continue_route(id,app.profile.campaign.encounter.revision),"return to regional map")
		check(Route.next_point(app.profile.campaign.route,region).is_empty(),"complete region "+region)
	# Every recovered graphical asset is decoded and usable by production renderer.
	for species in ["sakuraneko","inubari","suzumeko","kodamashi","mujina_kage","tsukimi_usagi","kodama_shin","karasu_origami","veil_bamboo","veil_roots","veil_clearing","veil_overhead"]:
		var texture := Stage.texture(species)
		check(texture!=null and texture.get_width()>0 and texture.get_height()>0,"editable imported asset "+species)
	for reduced in [false,true]:
		for i in range(21):
			var pose := Transition.fall_pose(i/20.0,reduced)
			check(pose.offset.is_finite() and pose.alpha>=0 and pose.alpha<=1,"bounded defeat motion")
	clean()
	print("UNIFICATION: %d checks, %d failures" % [checks,failures])
	quit(1 if failures else 0)

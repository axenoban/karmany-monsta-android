# Run in an exact 293ac5e checkout, passing --output=/absolute/directory.
extends SceneTree
func _initialize(): call_deferred("run")
func run():
	var output := ""
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--output="): output = arg.trim_prefix("--output=")
	assert(not output.is_empty())
	DirAccess.make_dir_recursive_absolute(output)
	var app = root.get_node("App")
	var Store = load("res://scripts/save_store.gd")
	app.storage = Store.new("user://generate-preview42.json")
	app.response_timer.stop()
	for file in DirAccess.get_files_at("res://tests/fixtures/preview38"):
		if not file.ends_with(".json"): continue
		app.profile = JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/preview38/" + file))
		app.profile.r1_intro = {"version":1,"status":"completed"}
		app.profile.first_session = {"version":1,"seen":["map","health"]}
		assert(app.commit_profile(app.profile))
		app.response_timer.stop()
		var handle := FileAccess.open(output.path_join(file), FileAccess.WRITE)
		handle.store_string(FileAccess.get_file_as_string(app.storage.base_path))
		handle.close()
	print("Preview42: seven fixtures generated by approved App/SaveStore")
	quit()
